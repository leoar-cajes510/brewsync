# BrewSync configuration — copy to .env (gitignored). PLACEHOLDERS ONLY: never commit real credentials.
#
# Three separate environments:
#   LOCAL       root .env → local PostgreSQL, ENVIRONMENT=development
#   TEST        TEST_DATABASE_URL → a separate LOCAL database (integration tests DROP/CREATE their schema)
#   PRODUCTION  DATABASE_URL only in the Vercel Production environment (and an off-repo secret file),
#               ENVIRONMENT=production
#
# Remote-database guard: outside ENVIRONMENT=production (or a Vercel Production deployment) the app,
# Alembic and the tests refuse any non-local database host unless BREWSYNC_ALLOW_REMOTE_DB=1.
# Alembic additionally needs `-x url=... -x confirm_host=<host>` for any remote host.

# Application database (psycopg driver). Local example:
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/brewsync_dev

# BrewSync tables live in their own schema so other tables in the same database are never touched
DB_SCHEMA=brewsync

# development | test | production
ENVIRONMENT=development

# Integration tests only — must be a LOCAL database (remote hosts are refused, no override)
TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/brewsync_test
TEST_DB_SCHEMA=brewsync_test

# Deliberate developer override to use a remote database outside production. Leave unset.
BREWSYNC_ALLOW_REMOTE_DB=

# Admin back-office sign-in without an activated terminal. Keep false (first terminal comes from setup).
INTERIM_ADMIN_LOGIN_WITHOUT_TERMINAL=false

# Automatic archive job (completed orders, Settings → archiving). Off unless deliberately enabled.
AUTO_ARCHIVE_ENABLED=false
AUTO_ARCHIVE_INTERVAL_SECONDS=900

# Setup wizard protection (Q-AUTH-8): random secret, at least 16 characters, kept by the installer.
# Required to complete setup or re-issue the first-terminal code. Leave empty in normal local development.
SETUP_TOKEN=
FIRST_TERMINAL_CODE_MINUTES=15
