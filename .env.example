# BrewSync backend configuration (copy to .env — .env is gitignored; never commit real credentials)

# PostgreSQL connection (Supabase or self-hosted; hosting is OPEN Q-ARCH-1)
# Supabase: Project Settings → Database → Connection string (session pooler, port 5432), psycopg driver:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/postgres
DATABASE_URL=

# BrewSync tables live in their own schema so other tables in the same database are never touched
DB_SCHEMA=brewsync

# Integration tests run in a separate schema (dropped and re-created by the tests)
TEST_DB_SCHEMA=brewsync_test

# Interim for OPEN Q-TRM-8 (first device): allow Admin back-office sign-in without an activated
# terminal so a fresh install can register its first terminal. Leave false unless needed.
INTERIM_ADMIN_LOGIN_WITHOUT_TERMINAL=false
